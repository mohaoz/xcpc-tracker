{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "exportKind", "version", "contests", "problems"],
  "properties": {
    "schemaVersion": {"const": 1},
    "exportKind": {"const": "local_catalog_snapshot"},
    "version": {"type": "string", "minLength": 1},
    "contests": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["contestId", "title", "problemIds", "sources", "tags", "aliases", "curationStatus"], "properties": {
      "contestId": {"type": "string", "minLength": 1}, "title": {"type": "string", "minLength": 1},
      "tags": {"$ref": "#/$defs/strings"}, "aliases": {"$ref": "#/$defs/strings"},
      "problemIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
      "curationStatus": {"enum": ["problem_listed", "reviewed"]},
      "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}},
      "awardCutoffs": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/awards"}]},
      "estimatedAwardCutoffs": {"$ref": "#/$defs/awards"}
    }}},
    "problems": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["problemId", "contestId", "ordinal", "title", "sources", "aliases"], "properties": {
      "problemId": {"type": "string", "minLength": 1}, "contestId": {"type": "string", "minLength": 1}, "ordinal": {"type": "string", "minLength": 1}, "title": {"type": "string", "minLength": 1},
      "rating": {"type": "number", "minimum": 0},
      "tags": {"$ref": "#/$defs/strings"}, "aliases": {"$ref": "#/$defs/strings"}, "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}}
    }}}
  },
  "$defs": {
    "strings": {"type": "array", "items": {"type": "string"}},
    "source": {"type": "object", "required": ["provider", "kind"], "properties": {
      "provider": {"type": "string", "minLength": 1}, "kind": {"type": "string", "minLength": 1}, "url": {"type": "string", "format": "uri"}, "is_default": {"type": "boolean"}, "provider_contest_id": {"type": "string"}, "provider_problem_id": {"type": "string"}, "source_title": {"type": "string"}
    }},
    "cutoff": {"type": "object", "required": ["rank", "solved", "penalty", "teamId"], "properties": {"rank": {"type": "integer", "minimum": 1}, "solved": {"type": "integer", "minimum": 0}, "penalty": {"type": "number", "minimum": 0}, "teamId": {"type": "string", "minLength": 1}}},
    "awards": {"type": "object", "required": ["source", "sourceProvider", "sourceLabel", "sourceUrl", "eligibleTeamCount", "cutoffs"], "properties": {
      "source": {"type": "string"}, "sourceProvider": {"type": "string"}, "sourceLabel": {"type": "string"}, "sourceUrl": {"type": "string", "format": "uri"}, "eligibleTeamCount": {"type": "integer", "minimum": 1},
      "cutoffs": {"type": "object", "required": ["gold", "silver", "bronze"], "additionalProperties": false, "properties": {"gold": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/cutoff"}]}, "silver": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/cutoff"}]}, "bronze": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/cutoff"}]}}}
    }}
  }
}
