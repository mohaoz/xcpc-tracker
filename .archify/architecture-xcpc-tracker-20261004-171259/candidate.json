  "cards": [
    {
      "dot": "cyan",
      "title": "目录与构建期",
      "items": [
        "唯一正式目录：catalog/default-catalog.min.json。",
        "生成比赛索引、coverage basis、逐场详情与导入映射。",
        "RankLand / XCPC Rating 经审核后在构建期补充牌线、标签与 Rating。"
      ]
    },
    {
      "dot": "emerald",
      "title": "浏览器本地使用",
      "items": [
        "静态前端无运行时后端；目录按需加载。",
        "成员账号、通过/尝试记录、偏好与手工比赛保存在本机。",
        "所选成员均无尝试和通过才是“未做”；非剧透隐藏牌线、标签和 Rating。"
      ]
    },
    {
      "dot": "rose",
      "title": "同步与授权边界",
      "items": [
        "QOJ 默认手动 JSON 导入，油猴模式须用户安装并启用。",
        "自动同步默认关闭，开启后同时调度 CF 与 QOJ；可见页面才运行。",
        "导入校验目录映射和本地身份，失败保留上次成功状态；不导出 Cookie。"
      ]
    }
  ]
